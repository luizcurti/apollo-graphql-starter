				{
					"name": "Mutation — deleteUser (requires login as owner)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// deleteUser requires being the owner (checkOwner) — since the user created",
									"// above hasn't authenticated their own session yet, we log in as",
									"// them here before calling deleteUser.",
									"pm.sendRequest({",
									"  url: pm.collectionVariables.get('baseUrl'),",
									"  method: 'POST',",
									"  header: { 'Content-Type': 'application/json' },",
									"  body: {",
									"    mode: 'raw',",
									"    raw: JSON.stringify({",
									"      query: 'mutation { login(data: { userName: \"test.user99\", password: \"Senha123\" }) { userId } }'",
									"    })",
									"  }",
									"}, function (err, res) {",
									"  if (err) { console.error('login test.user99 failed', err); return; }",
									"  var json = res.json();",
									"  if (json && json.data && json.data.login) {",
									"    pm.collectionVariables.set('loggedUserId', json.data.login.userId);",
									"  }",
									"});"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"const body = pm.response.json();",
									"pm.test('Status 200', () => pm.response.to.have.status(200));",
									"pm.test('No GraphQL errors', () => pm.expect(body.errors).to.be.undefined);",
									"pm.test('Returns true', () => {",
									"  pm.expect(body.data.deleteUser).to.be.true;",
									"});",
									"",
									"// Restores the original session (elisa.pereira) for the following folders,",
									"// since the just-deleted user can no longer authenticate.",
									"pm.sendRequest({",
									"  url: pm.collectionVariables.get('baseUrl'),",
									"  method: 'POST',",
									"  header: { 'Content-Type': 'application/json' },",
									"  body: {",
									"    mode: 'raw',",
									"    raw: JSON.stringify({",
									"      query: 'mutation { login(data: { userName: \"elisa.pereira\", password: \"Senha123\" }) { userId } }'",
									"    })",
									"  }",
									"}, function (err, res) {",
									"  if (err) { console.error('re-login elisa.pereira failed', err); return; }",
									"  var json = res.json();",
									"  if (json && json.data && json.data.login) {",
									"    pm.collectionVariables.set('loggedUserId', json.data.login.userId);",
									"  }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
