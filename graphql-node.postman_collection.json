								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"query\": \"mutation LOGIN($userName: String!, $password: String!) { login(data: { userName: $userName, password: $password }) { userId } }\",\n  \"variables\": {\n    \"userName\": \"elisa.pereira\",\n    \"password\": \"Senha123\"\n  }\n}"
