# Server
PORT=4003
NODE_ENV=development

# REST API (json-server or real API)
API_URL=http://localhost:3000

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars

# Database
DATABASE_CLIENT=mysql2
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=graphql_mysql
DATABASE_USER=
DATABASE_PASSWORD=

# MySQL root password (used by docker-compose only)
MYSQL_ROOT_PASSWORD=

# Redis — required in production for GraphQL subscriptions
# REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
