{
  "name": "graphql-node",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "npm run lint:check && npm run test && npm run build",
    "dev": "nodemon -e 'js' -r dotenv/config -r sucrase/register src/index.js",
    "build": "rimraf ./dist && sucrase ./src -d ./dist --transforms imports",
    "start": "node -r dotenv/config dist/index.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:check": "eslint src/ --max-warnings=0",
    "lint:ci": "eslint src/ --max-warnings=10",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "migrate": "knex --knexfile src/knex/knexfile.js migrate:latest",
    "migrate:rollback": "knex --knexfile src/knex/knexfile.js migrate:rollback",
    "seed": "knex --knexfile src/knex/knexfile.js seed:run",
    "db:setup": "npm run migrate && npm run seed",
    "audit:high": "npm audit --audit-level=high",
    "audit:ci": "npm audit --audit-level=high || echo 'Security vulnerabilities found in legacy dependencies'",
    "security": "npm run audit:ci"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "apollo-datasource": "^0.9.0",
    "apollo-server": "2.23.0",
    "apollo-server-caching": "^0.7.0",
    "bcrypt": "^6.0.0",
    "dataloader": "^2.0.0",
    "dotenv": "^8.5.1",
    "graphql": "^15.9.0",
    "graphql-depth-limit": "^1.1.0",
    "graphql-rate-limit": "^3.3.0",
    "graphql-redis-subscriptions": "^2.7.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^2.5.1",
    "mysql2": "^3.19.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rimraf": "^3.0.2"
  },
  "devDependencies": {
    "@sucrase/jest-plugin": "^3.0.0",
    "eslint": "^7.25.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^3.4.0",
    "jest": "^29.7.0",
    "nodemon": "^2.0.7",
    "prettier": "^2.2.1",
    "sucrase": "^3.18.1"
  },
  "jest": {
    "transform": {
      "^.+\\.js$": "@sucrase/jest-plugin"
    }
  }
}
